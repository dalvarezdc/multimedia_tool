# ==============================================================================
# Global Video Provider Default ('seedance' or 'grok')
# ==============================================================================
DEFAULT_VIDEO_PROVIDER=seedance

# ==============================================================================
# BytePlus ModelArk API Configuration (Seedance)
# ==============================================================================
# Your BytePlus ModelArk API Key from the BytePlus Console
ARK_API_KEY=your_byteplus_ark_api_key_here

# Region API Base URL (default is ap-southeast-1)
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Model Endpoint IDs or Model Names
# Director LLM (used for storyboard breakdown, scriptwriting, and prompt generation)
ARK_LLM_MODEL=seed-2-0-lite-260228

# Seedance Video Generation Model (or your deployed Endpoint ID ep-xxxxxx)
ARK_SEEDANCE_MODEL=dreamina-seedance-2-5-260628

# Seedance Defaults
SEEDANCE_WATERMARK=false
SEEDANCE_DURATION_SEC=5
SEEDANCE_RATIO=16:9

# ==============================================================================
# xAI Grok Imagine Video Configuration
# ==============================================================================
# Your xAI API key from https://console.x.ai
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_VIDEO_MODEL=grok-imagine-video-1.5
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# ==============================================================================
# Auth (session history, optional 2FA, OAuth)
# ==============================================================================
# Optional. If unset, a secret is generated in data/.auth_secret
# AUTH_SECRET=
# AUTH_PUBLIC_URL=http://localhost:8080
# AUTH_COOKIE_SECURE=0
#
# Google: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# GitHub: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# Proton "Sign in with Proton" is partner OAuth. Set these if you have client credentials.
# PROTON_CLIENT_ID=
# PROTON_CLIENT_SECRET=
# PROTON_AUTHORIZE_URL=https://account.proton.me/oauth/authorize
# PROTON_TOKEN_URL=https://account.proton.me/api/io.proton.oauth/v1/token
# PROTON_USERINFO_URL=https://account.proton.me/api/core/v4/users

# ==============================================================================
# Audio & Voiceover Configuration (Optional / Integrations)
# ==============================================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ==============================================================================
# Pipeline & Rendering Configuration
# ==============================================================================
OUTPUT_DIR=./renders
ASSETS_DIR=./assets
CUTSCENES_DIR=./cutscenes
LOG_LEVEL=INFO
REMOTION_CONCURRENCY=4

# ==============================================================================
# Server / Docker
# ==============================================================================
# 1 = FastAPI also serves ui/*.html (local `make dev`)
# 0 = API-only; nginx in docker-compose serves the UI
SERVE_UI=1
